# Host address used by Vault and, unless BESU_RPC_HOST is set, by Besu RPC.
# Use the LAN address when clients are not on the Docker host.
HOST_IP=host.docker.internal

BESU_CHAIN_ID=1337
BESU_RPC_PORT=8545
VAULT_PORT=8200

# Optional. Defaults to HOST_IP when unset.
# BESU_RPC_HOST=host.docker.internal
