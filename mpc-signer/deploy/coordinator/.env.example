# Copy to .env (chmod 600).
MPC_IMAGE=registry.example.com/mpc-signer:1.0.0
MPC_BIND_IP=10.10.0.5
MPC_PORT=9100
# how the NODES reach THIS coordinator's relay (its private/VPN address)
MPC_RELAY_URL=ws://10.10.0.5:9100/relay
# Besu JSON-RPC (an RPC node, never a validator)
MPC_BESU_RPC=http://10.10.0.20:8545
# hot senders that keep a presignature pool (SENDER01 after the key ceremony), comma-separated
MPC_POOL_KEYS=
# presignatures kept ready per hot key (bursts) and concurrent presign sessions
MPC_POOL_TARGET=500
MPC_REFILL_CONCURRENCY=8
# same value as on every node
MPC_NODE_TOKEN=
# admin API token (/admin/*): only for the operator/bastion and the proxy (/createaccount)
MPC_ADMIN_TOKEN=
# token Prometheus sends to GET /metrics (monitoring/secrets/mpc-metrics-token). Empty = /metrics
# is open to anyone who can reach port 9100 (it holds no secrets, but set one in production).
MPC_METRICS_TOKEN=
