# Copy to .env (chmod 600).
MPC_IMAGE=registry.example.com/mpc-signer:1.3.0
# layout (docs/production-layout.md): coord1 on .135, coord2 on .136. Clients reach them through
# HAProxy on the VIP 192.168.68.150:9100 (coord1, coord2 as backup); both run all the time.
MPC_BIND_IP=192.168.68.135
MPC_PORT=9100
# how the NODES reach THIS coordinator's relay: its OWN address, never the VIP
MPC_RELAY_URL=ws://192.168.68.135:9100/relay
# Besu JSON-RPC through HAProxy (rpc1, rpc2 as backup), never a validator
MPC_BESU_RPC=http://192.168.68.150:8545
# Presignature pools. Every key has a pool class, stored with the key on the MPC nodes:
#   big   -> MPC_POOL_TARGET presignatures (hot senders, e.g. SENDER01)
#   small -> MPC_POOL_TARGET_SMALL presignatures (e.g. accounts created through the proxy)
#   none  -> no pool: signed with the full interactive protocol (cold, ~0.5-1.5 s)
# Keys without a stored class (SENDER01 from the key ceremony): "big" if listed in MPC_POOL_KEYS
# (comma-separated), otherwise "none". An EMPTY MPC_POOL_KEYS makes every such key "big".
MPC_POOL_KEYS=
MPC_POOL_TARGET=500
# 0 = this coordinator keeps no small pools (e.g. the standby coord2, to halve the presign work)
MPC_POOL_TARGET_SMALL=20
# concurrent presign sessions
MPC_REFILL_CONCURRENCY=8
# same value as on every node
MPC_NODE_TOKEN=
# admin API token (/admin/*): only for the operator/bastion and the proxy (/createaccount)
MPC_ADMIN_TOKEN=
# token Prometheus sends to GET /metrics (monitoring/secrets/mpc-metrics-token). Empty = /metrics
# is open to anyone who can reach port 9100 (it holds no secrets, but set one in production).
MPC_METRICS_TOKEN=
