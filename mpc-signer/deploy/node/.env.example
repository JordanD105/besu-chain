# Copy to .env (chmod 600). init.sh fills MPC_NODE_PASSPHRASE for you.
MPC_IMAGE=registry.example.com/mpc-signer:1.0.0
# this node's id in cluster.json: 0, 1 or 2 (different on every host)
MPC_NODE_ID=0
# this host's private / WireGuard address (the port is published only there)
MPC_BIND_IP=10.10.0.10
MPC_PORT=7000
# unlocks this node's sealed key share; generated by init.sh; keep a copy in THIS team's vault
MPC_NODE_PASSPHRASE=
# shared secret between the coordinator(s) and the nodes (same value on all nodes + coordinators)
MPC_NODE_TOKEN=
# CPU threads for presigning (about the host's cores)
MPC_COMPUTE_THREADS=4
