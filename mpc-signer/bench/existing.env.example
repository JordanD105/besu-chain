# Benchmark against YOUR running stack: copy to bench/existing.env (git-ignored) and adjust.
# With this file present, bench/run-bench.sh uses OLD_STACK=existing automatically and deploys
# nothing for the old stack (only the MPC cluster is started).
#
# Defaults (when a variable is unset) match ../besu-test-network and ../besu-vault-web3signer
# running on this host.

# Besu JSON-RPC (rpcnode). The MPC coordinator forwards to the same node.
BESU_RPC=http://127.0.0.1:8545

# Web3Signer (eth1 mode). W3S_FROM defaults to its first account.
W3S_RPC=http://127.0.0.1:9000
#W3S_FROM=0x...

# Vault: the "proxy sendFromVault" path reads this KV v2 key once per transaction.
# Token: VAULT_TOKEN, or VAULT_TOKEN_FILE (default ../besu-vault-web3signer/.secrets/web3signer-token).
# Key path default: the first keyPath in ../besu-vault-web3signer/web3signer/keys/*.yaml.
VAULT_ADDR=http://127.0.0.1:8200
#VAULT_TOKEN=
#VAULT_TOKEN_FILE=../besu-vault-web3signer/.secrets/web3signer-token
#VAULT_KEY_PATH=web3signer/data/accounts/sender-001

# Phase C sends real (zero-value) transactions to 0x...dEaD from your accounts. Off by default.
#BENCH_SEND=1
