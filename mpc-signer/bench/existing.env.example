# Benchmark the MPC signer against YOUR running Besu node: copy to bench/existing.env
# (git-ignored) and adjust. With this file present, bench/run-bench.sh uses BESU_STACK=existing
# automatically and starts no Besu of its own (only the MPC cluster is started).
#
# Defaults (when a variable is unset) match ../besu-test-network running on this host.

# Besu JSON-RPC (rpcnode) used for chain id, nonces and "mined" checks.
BESU_RPC=http://127.0.0.1:8545

# Besu RPC as seen by the MPC coordinator. Default: BESU_RPC with 127.0.0.1/localhost rewritten
# to host.docker.internal (MPC_RUNTIME=docker); set it if the coordinator reaches Besu differently.
#MPC_BESU_RPC=http://host.docker.internal:8545

# Chain id for the MPC policy and the transactions. Default: eth_chainId of BESU_RPC.
#CHAIN_ID=1337

# Sender address managed by the MPC coordinator. Default: its first eth_accounts entry.
#MPC_FROM=0x...

# Phase C sends real (zero-value, zero gas price) transactions to 0x...dEaD from the MPC
# account. Off by default with an existing node.
#BENCH_SEND=1
