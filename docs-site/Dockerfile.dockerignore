# Build context = the repository root. Keep secrets, state and large files out.
.git
**/.env
**/node_modules
ansible/state
remix/remix-live
mpc-signer/target
**/target
**/*.tar
**/*.tar.gz
**/*.zip
**/*.png.orig
docs-site/site
# the other images' offline archives (the documentation build needs only docs-site/offline/)
chainlens/offline
proxy/offline
mpc-signer/offline
remix/offline
