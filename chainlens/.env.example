# Besu JSON-RPC endpoint to index.
# Production layout (docs/production-layout.md): chainlens on .136 reads rpc2 (.133), so the
# explorer's polling stays off rpc1, which serves the proxy and coordinators.
#   BESU_RPC=http://192.168.68.133:8545
# Development, Besu on the same host (besu-test-network rpcnode): http://host.docker.internal:8545
BESU_RPC=http://host.docker.internal:8545

# Host port for the explorer UI/API
PORT=30100

# Max JSON-RPC calls per batch request (Besu default limit: 1024)
#RPC_BATCH_SIZE=200
