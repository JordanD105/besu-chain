# Besu JSON-RPC endpoint to index.
# Besu on the same host (besu-test-network rpcnode): http://host.docker.internal:8545
# Besu on another machine: http://<besu-ip>:8545
BESU_RPC=http://host.docker.internal:8545

# Host port for the explorer UI/API
PORT=30100

# Max JSON-RPC calls per batch request (Besu default limit: 1024)
#RPC_BATCH_SIZE=200
