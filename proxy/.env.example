# Proxy settings for the production layout (docs/overview/production-layout.md). Copy to .env (chmod 600)
# on BOTH proxy hosts (.135 = proxy1, .136 = proxy2), identical. Never commit .env.

# Besu JSON-RPC and the MPC signer, both through HAProxy on the VIP (rpc1/coord1, rpc2/coord2 as
# backup). rpc1 and rpc2 must have 192.168.68.150 in BESU_HOST_ALLOWLIST.
BESU_IP=192.168.68.150
BESU_PORT=8545
WEB3SIGNER_IP=192.168.68.150
WEB3SIGNER_PORT=9100
MPC_ADMIN_URL=http://192.168.68.150:9100
# the coordinators' MPC_ADMIN_TOKEN
MPC_ADMIN_TOKEN=

# the hot MPC key created in the key ceremony (also the minter of the NFT collections)
SENDER01=0x0000000000000000000000000000000000000000

# API port (published on all addresses; clients use the proxy VIP 192.168.68.151:30000)
PORT=30000

# Redis image (exact version)
REDIS_IMAGE=redis:8.10.3
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.67.0

# Presignature pool class of accounts created by /createaccount when the request names none:
# big, small or none (docs/deployment/mpc-signer-production.md, "Presignature pools")
MPC_NEW_ACCOUNT_POOL=small

# Sections (docs/features/sections.md): the SectionRegistry and its admin key (Ansible: state/registry.json)
# REGISTRY_CONTRACT=0x...
# REGISTRY_ADMIN=0x...
# REGISTRY_FROM_BLOCK=0          # the block the registry was deployed in (its events are read from there)
# CONTRACT_CENTER=0x...          # the MPC key that deploys every contract (Ansible: state/contract-center)
# Admin API (/admin/*): token (16+ characters) and the source addresses allowed to use it
# ADMIN_TOKEN=
# ADMIN_ALLOWED_IPS=192.168.68.130 192.168.68.139
# true: /createaccount and /transfer need a section's X-Section-Key (no SENDER01 fallback)
# SECTION_KEY_REQUIRED=false

# Optional
# NFT_BASE_URL=http://192.168.68.151:30000
# METRICS_TOKEN=            # bearer token Prometheus must send to GET /metrics
# SENDER_CHECK_MS=2000      # background chain check (docs/components/proxy.md)
# SENDER_STUCK_MS=30000
# SENDER_STUCK_BLOCKS=10
