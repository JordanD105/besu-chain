# Proxy settings for the production layout (docs/production-layout.md). Copy to .env (chmod 600)
# on BOTH proxy hosts (.132 = proxy1, .133 = proxy2), identical. Never commit .env.

# Besu JSON-RPC and the MPC signer, both through HAProxy on the VIP (rpc1/coord1, rpc2/coord2 as
# backup). rpc1 and rpc2 must have 192.168.68.150 in BESU_HOST_ALLOWLIST.
BESU_IP=192.168.68.150
BESU_PORT=8545
WEB3SIGNER_IP=192.168.68.150
WEB3SIGNER_PORT=9100
MPC_ADMIN_URL=http://192.168.68.150:9100
# the coordinators' MPC_ADMIN_TOKEN
MPC_ADMIN_TOKEN=

# the hot MPC key created in the key ceremony (also the minter of the NFT collections)
SENDER01=0x0000000000000000000000000000000000000000

# API port (published on all addresses; clients use the proxy VIP 192.168.68.151:30000)
PORT=30000

# Optional
# NFT_BASE_URL=http://192.168.68.151:30000
# METRICS_TOKEN=            # bearer token Prometheus must send to GET /metrics
# SENDER_CHECK_MS=2000      # background chain check (docs/proxy-with-mpc-signer.md)
# SENDER_STUCK_MS=30000
# SENDER_STUCK_BLOCKS=10
