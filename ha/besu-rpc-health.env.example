# Settings of besu-rpc-health (rpc-health.py) for a setup without Ansible: copy to
# /etc/besu-rpc-health.env on BOTH HAProxy hosts. With Ansible this file is generated
# (ansible/templates/besu-rpc-health.env.j2). Shown for .135; on .136 set LOCAL_NODES="rpc2" and
# HEAD_REFERENCE to val2 (also http://127.0.0.1:8645).
#
# RPC_NODES: name=url=local port=container, in HAProxy's order (port 8411 = rpc1, 8412 = rpc2)
RPC_NODES="rpc1=http://192.168.68.135:8555=8411=besu-rpc1-besu-1 rpc2=http://192.168.68.136:8555=8412=besu-rpc2-besu-1 "
# RPC nodes running on THIS host: the only ones it restarts
LOCAL_NODES="rpc1"
# this host's validator, as a reference for the chain head (its RPC listens on localhost)
HEAD_REFERENCE="http://127.0.0.1:8645"
# Host header the RPC nodes accept (the RPC VIP)
HOST_HEADER="192.168.68.150"
# newest block older than this (seconds) while another node has newer blocks = stalled
MAX_AGE=30
# more blocks behind the best head than this = behind
MAX_BEHIND=10
CHECK_SECONDS=2
# restart a local RPC node stalled this long while the chain moves on; 0 = never
RESTART_MINUTES=5
# status of every node as JSON: curl -s http://127.0.0.1:8410/
STATUS_PORT=8410
