      "targets": [
        {
          "refId": "A",
          "expr": "max by (section, role) (proxy_section_balance_eth{section=~\"$section\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "section",
            "columnField": "role",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
