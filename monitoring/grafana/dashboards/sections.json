      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(proxy_section_balance_eth{role=\"upfront\",active=\"1\"} < on() group_left() (proxy_section_low_balance_eth > 0)) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
