    {
      "type": "stat",
      "title": "Presignatures ready",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Hot-path presignatures across the hot keys (MPC_POOL_KEYS).",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mpc_pool_ready{job=\"mpc-coordinator\"})",
          "legendFormat": "",
          "instant": true,
          "datasource": {
