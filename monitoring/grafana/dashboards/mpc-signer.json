      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mpc_pool_ready{job=\"mpc-coordinator\",instance=~\"$coordinator\"}",
