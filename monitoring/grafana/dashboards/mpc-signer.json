          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(mpc_pool_target{job=\"mpc-coordinator\",instance=~\"$coordinator\"})",
          "legendFormat": "target",
          "datasource": {
