      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "This is the sustained hot-path capacity: signatures/s above it drain the pool.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mpc_presigs_generated_total{job=\"mpc-coordinator\",instance=~\"$coordinator\"}[1m]))",
          "legendFormat": "presigs/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
