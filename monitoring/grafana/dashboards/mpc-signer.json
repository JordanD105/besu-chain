        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pool per hot key",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
