    {
      "type": "timeseries",
      "title": "Average presign duration",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mpc_presign_seconds_total{job=\"mpc-coordinator\",instance=~\"$coordinator\"}[5m])) / sum(rate(mpc_presigs_generated_total{job=\"mpc-coordinator\",instance=~\"$coordinator\"}[5m]))",
          "legendFormat": "avg",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
