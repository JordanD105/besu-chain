        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(mpc_signs_total{job=\"mpc-coordinator\",instance=~\"$coordinator\"}[1m]))",
          "legendFormat": "{{path}}",
