# Copy to .env (chmod 600). Never commit .env.
# REQUIRED: this monitoring host's own private IP (see: hostname -I). Grafana is published there.
BIND_IP=
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# a long random password, e.g.  openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change-me
# Prometheus has no login: localhost only (use an SSH tunnel to look at it)
PROMETHEUS_BIND=127.0.0.1:9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
GRAFANA_IMAGE=grafana/grafana:13.2
