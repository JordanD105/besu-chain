# Generated by Ansible (ansible/templates/haproxy.cfg.j2) from the IP plan: edits are overwritten.
# The SAME file on both HA hosts: both run HAProxy all the time; keepalived decides which one
# holds the VIP {{ vip_rpc }}.
#   haproxy -c -f /etc/haproxy/haproxy.cfg && systemctl enable --now haproxy
# Needs net.ipv4.ip_nonlocal_bind=1 (binding the VIP on the host that does not hold it) and, with
# SELinux, setsebool -P haproxy_connect_any 1. Steps: ha/README.md
global
    log /dev/log local0
    maxconn 4000              # a few hundred connections are used; higher values need more file descriptors

defaults
    mode http
    log global
    option httplog
    timeout connect 3s
    timeout client  120s
    timeout server  120s      # cold MPC signing and key generation take seconds
    retries 2
    option redispatch

# Health endpoint for keepalived's check (local only)
frontend health
    bind 127.0.0.1:8404
    monitor-uri /healthz

# Besu JSON-RPC: rpc1 normally, rpc2 only when rpc1 is unhealthy. One node at a
# time, so the proxy reads nonces from the same pool the coordinator sends to. Health comes from
# besu-rpc-health (ha/rpc-health.py, one local port per node): a node is used only if it is not
# syncing, within {{ rpc_max_blocks_behind }} blocks of the best head and its newest block is younger
# than {{ rpc_max_block_age }} s (unless the whole chain is halted). eth_syncing alone missed a node
# that had stopped importing. rpc1 and rpc2 must have {{ vip_rpc }} in BESU_HOST_ALLOWLIST: clients
# send Host: {{ vip_rpc }}.
frontend besu_rpc
    bind {{ vip_rpc }}:8545
    default_backend besu_rpc
backend besu_rpc
    option httpchk GET /
    http-check expect status 200
{% for n in rpc_nodes %}
    server {{ n.name }} {{ ip_of[n.host] }}:{{ n.rpc_port }} check addr 127.0.0.1 port {{ rpc_health_base_port + loop.index }} inter 2s fall 2 rise 2{{ ' backup' if not loop.first else '' }}
{% endfor %}

# MPC signer (Web3Signer-compatible JSON-RPC + admin API): coord1 normally, coord2 when coord1 is
# down. coord2 runs all the time with its own presignature pool full (warm) and
# re-reads the key list from the MPC nodes, so it signs for every account at once.
frontend mpc_signer
    bind {{ vip_rpc }}:9100
    default_backend mpc_signer
backend mpc_signer
    option httpchk GET /health
    http-check expect status 200
{% for c in coordinators %}
    server {{ c.name }} {{ ip_of[c.host] }}:9100 check inter 2s fall 3 rise 2{{ ' backup' if not loop.first else '' }}
{% endfor %}
