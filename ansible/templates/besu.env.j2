# {{ node.name }} on {{ ansible_host }}. Managed by Ansible (ansible/05-besu.yml): local edits are overwritten.
BESU_IMAGE={{ besu_image }}
BESU_ROLE={{ node.role }}
NODE_NAME={{ node.name }}
P2P_HOST={{ ansible_host }}
BIND_IP={{ ansible_host }}
P2P_PORT={{ node.p2p_port }}
METRICS_PORT={{ node.metrics_port }}
RPC_BIND_IP={{ ansible_host if node.rpc_bind == 'host' else '127.0.0.1' }}
RPC_PORT={{ node.rpc_port }}
WS_PORT={{ node.ws_port }}
JAVA_OPTS={{ besu_java_opts }}
{% if node.host_network %}
COMPOSE_FILE=docker-compose.host.yml
{% endif %}
{% if node.role == 'rpc' %}
BESU_HOST_ALLOWLIST={{ ansible_host }},{{ vip_rpc }},localhost,127.0.0.1
BESU_RPC_HTTP_API=ETH,NET,WEB3,TXPOOL
BESU_RPC_WS_API=ETH,NET,WEB3,TXPOOL
{% endif %}
