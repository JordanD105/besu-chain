#!/bin/bash
# Generated by Ansible (ansible/templates/proxy-start.sh.j2): edits are overwritten.
# keepalived notify_master for the proxy VIP (/etc/keepalived/proxy-start.sh, chmod 700): this host
# now holds {{ vip_proxy }}, so it runs the proxy. The proxy takes its nonces from the chain.
# PROXY_DIR: the proxy's directory on this host (same .env on both HA hosts).
PROXY_DIR={{ repo_dir }}/proxy
logger -t besu-ha "proxy VIP taken: starting the proxy"
cd "$PROXY_DIR" && /usr/bin/docker compose up -d proxy
