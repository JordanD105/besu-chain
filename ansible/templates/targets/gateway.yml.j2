# Generated by Ansible from the IP plan: edits are overwritten. The section gateways (14-gateway.yml):
# one per host of the gateway_hosts group, named after its section.
{% if gateway_hosts_list | length %}
{% for h in gateway_hosts_list %}
- targets: ["{{ ip_of[h] }}:{{ gateway_port }}"]
  labels: { name: gateway-{{ hostvars[h].gateway_section }} }
{% endfor %}
{% else %}
[]
{% endif %}
