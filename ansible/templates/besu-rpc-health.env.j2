# Generated by Ansible (ansible/templates/besu-rpc-health.env.j2): edits are overwritten.
# Read by besu-rpc-health (ha/rpc-health.py); HAProxy checks node N on 127.0.0.1:{{ rpc_health_base_port }}+N.
RPC_NODES="{% for n in rpc_nodes %}{{ n.name }}=http://{{ ip_of[n.host] }}:{{ n.rpc_port }}={{ rpc_health_base_port + loop.index }}=besu-{{ n.name }}-besu-1 {% endfor %}"
LOCAL_NODES="{{ rpc_nodes | selectattr('host', 'equalto', inventory_hostname) | map(attribute='name') | join(' ') }}"
{% set local_validators = besu_nodes | selectattr('role', 'equalto', 'validator') | selectattr('host', 'equalto', inventory_hostname) | list %}
HEAD_REFERENCE="{{ ('http://127.0.0.1:' ~ local_validators[0].rpc_port) if local_validators else '' }}"
HOST_HEADER="{{ vip_rpc }}"
MAX_AGE={{ rpc_max_block_age }}
MAX_BEHIND={{ rpc_max_blocks_behind }}
CHECK_SECONDS=2
RESTART_MINUTES={{ rpc_auto_restart_minutes }}
STATUS_PORT={{ rpc_health_status_port }}
