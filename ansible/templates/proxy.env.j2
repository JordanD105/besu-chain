# Proxy on {{ ansible_host }} (same on .135 and .136). Managed by Ansible (ansible/06-proxy.yml).
# keepalived starts it on the host holding {{ vip_proxy }}.
BESU_IP={{ vip_rpc }}
BESU_PORT=8545
WEB3SIGNER_IP={{ vip_rpc }}
WEB3SIGNER_PORT=9100
MPC_ADMIN_URL=http://{{ vip_rpc }}:9100
MPC_ADMIN_TOKEN={{ mpc_admin_token }}
SENDER01={{ sender01 }}
PORT=30000
REDIS_IMAGE={{ redis_image }}
{% for k, v in (proxy_extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
