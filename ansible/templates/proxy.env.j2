# Proxy on {{ ansible_host }} (same on .135 and .136). Managed by Ansible (ansible/06-proxy.yml).
# keepalived starts it on the host holding {{ vip_proxy }}.
BESU_IP={{ vip_rpc }}
BESU_PORT=8545
SIGNER_IP={{ vip_rpc }}
SIGNER_PORT=9100
MPC_ADMIN_URL=http://{{ vip_rpc }}:9100
MPC_ADMIN_TOKEN={{ mpc_admin_token }}
SENDER01={{ sender01 }}
PORT=30000
REDIS_IMAGE={{ redis_image }}
REDIS_EXPORTER_IMAGE={{ redis_exporter_image }}
MPC_NEW_ACCOUNT_POOL={{ mpc_new_account_pool }}
# Sections (docs/features/sections.md): the SectionRegistry deployed by 06-proxy.yml, and the admin API
REGISTRY_CONTRACT={{ registry.address | default('') }}
REGISTRY_ADMIN={{ registry.admin | default('') }}
REGISTRY_FROM_BLOCK={{ registry_from_block }}
CONTRACT_CENTER={{ contract_center }}
ADMIN_TOKEN={{ proxy_admin_token }}
UPFRONT_LOW_BALANCE_ETH={{ upfront_low_balance_eth }}
SENDER01_LOW_BALANCE_ETH={{ sender01_low_balance_eth }}
# memos (docs/features/memos.md)
MEMO_DEFAULT_LANG={{ memo_default_lang }}
# the commit the hosts have (chainlens shows it)
APP_COMMIT={{ repo_commit }}
# a +x / -x can be undone for this many days (docs/features/transfer-undo.md)
TRANSFER_UNDO_DAYS={{ transfer_undo_days }}
MEMO_SKIP_CONTRACTS={{ memo_skip_contracts | join(' ') }}
SECTION_KEY_REQUIRED={{ 'true' if sections_required | bool else 'false' }}
ADMIN_ALLOWED_IPS={{ ([operator_ip] + (groups['monitoring_hosts'] | map('extract', ip_of) | list)) | join(' ') }}
{% for k, v in (proxy_extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
