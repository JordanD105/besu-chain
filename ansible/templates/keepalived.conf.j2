# Generated by Ansible (ansible/templates/keepalived.conf.j2) from the IP plan: edits are overwritten.
# keepalived on {{ ansible_host }}: two floating IPs, {{ 'normally held here (priority {{ 150 if inventory_hostname == ha_primary else 100 }})' if inventory_hostname == ha_primary else 'held here only when ' ~ ip_of[ha_peer] ~ ' fails (priority 100)' }}:
#   {{ vip_rpc }}  HAProxy: Besu RPC :8545 and MPC signer :9100
#   {{ vip_proxy }}  the proxy :30000 (only the holder runs a proxy)
global_defs {
    router_id besu_{{ inventory_hostname }}
    script_user root
    enable_script_security
}

vrrp_script chk_haproxy {
    script "/usr/bin/curl -sf -m 2 -o /dev/null http://127.0.0.1:8404/healthz"
    interval 2
    fall 3
    rise 2
}

vrrp_script chk_proxy {
    script "/etc/keepalived/check-proxy.sh"
    interval 3
    fall 3
    rise 2
}

vrrp_instance VI_RPC {
    state BACKUP
    nopreempt
    interface {{ vrrp_if }}
    virtual_router_id 51
    priority {{ 150 if inventory_hostname == ha_primary else 100 }}
    advert_int 1
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
        {{ ip_of[ha_peer] }}
    }
    authentication {
        auth_type PASS
        auth_pass {{ vrrp_pass_rpc }}
    }
    virtual_ipaddress {
        {{ vip_rpc }}/{{ vip_prefix }}
    }
    track_script {
        chk_haproxy
    }
}

vrrp_instance VI_PROXY {
    state BACKUP
    nopreempt
    interface {{ vrrp_if }}
    virtual_router_id 52
    priority {{ 150 if inventory_hostname == ha_primary else 100 }}
    advert_int 1
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
        {{ ip_of[ha_peer] }}
    }
    authentication {
        auth_type PASS
        auth_pass {{ vrrp_pass_proxy }}
    }
    virtual_ipaddress {
        {{ vip_proxy }}/{{ vip_prefix }}
    }
    track_script {
        chk_proxy
    }
    notify_master "/etc/keepalived/proxy-start.sh"
    notify_backup "/etc/keepalived/proxy-stop.sh"
    notify_fault  "/etc/keepalived/proxy-stop.sh"
}
