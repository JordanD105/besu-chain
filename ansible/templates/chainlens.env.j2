# Managed by Ansible (ansible/09-monitoring.yml). Chainlens reads rpc2.
BESU_RPC=http://{{ ip_of[chainlens_rpc_host] }}:{{ (besu_nodes | selectattr('host', 'equalto', chainlens_rpc_host) | selectattr('role', 'equalto', 'rpc') | first).rpc_port }}
PORT=30100
# Records written by the Deploy page (copied back to the repository by 09-monitoring.yml)
CONTRACT_LOCAL_DIR={{ chainlens_local_registry }}
{% if chainlens_deploy_enabled | bool %}
# Deploy page (chainlens_deploy_enabled): only from operator_ip, with the token
DEPLOY_ENABLED=true
DEPLOY_TOKEN={{ chainlens_deploy_token }}
DEPLOYER={{ chainlens_deployer }}
DEPLOY_ALLOWED_IPS={{ ([operator_ip] + chainlens_deploy_ips) | join(' ') }}
COORDINATOR_URL=http://{{ vip_rpc }}:9100
SENDER01={{ sender01 }}
MAX_GAS={{ mpc_max_gas }}
{% else %}
DEPLOY_ENABLED=false
{% endif %}
