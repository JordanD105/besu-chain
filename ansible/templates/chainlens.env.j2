# Managed by Ansible (ansible/11-chainlens.yml). Chainlens reads rpc2.
BESU_RPC=http://{{ ip_of[chainlens_rpc_host] }}:{{ (besu_nodes | selectattr('host', 'equalto', chainlens_rpc_host) | selectattr('role', 'equalto', 'rpc') | first).rpc_port }}
PORT=30100
SENDER01={{ sender01 }}
# Contracts registered on chain (SectionRegistry), read from its deployment block
REGISTRY_CONTRACT={{ registry.address | default('') }}
REGISTRY_FROM_BLOCK={{ registry_from_block }}
CONTRACT_CENTER={{ contract_center }}
# Records of contracts deployed with besu-production/operator/deploy-contract.js (repository) and
# by earlier versions of the Deploy page (copied back to the repository by 11-chainlens.yml)
CONTRACT_LOCAL_DIR={{ chainlens_local_registry }}
# Roles (docs/components/chainlens.md): sign in with the admin token (everything) or a section token
# (made by the admin on the section's page: only that section). Nobody else sees anything, unless
# CHAINLENS_PUBLIC=true (the read-only explorer for anyone the firewall lets in).
ADMIN_TOKEN={{ chainlens_deploy_token }}
# the admin's source addresses (empty: any address the firewall lets in)
ADMIN_ALLOWED_IPS={{ chainlens_admin_ips | join(' ') }}
CHAINLENS_PUBLIC={{ 'true' if chainlens_public | bool else 'false' }}
# the section tokens' hashes (host: chainlens_tokens_dir)
CHAINLENS_TOKENS_DIR={{ chainlens_tokens_dir }}
TOKENS_DIR=/tokens
{% if chainlens_deploy_enabled | bool or chainlens_sections_enabled | bool %}
# Admin pages (Deploy, Sections) forward to the proxy's admin API.
PROXY_ADMIN_URL=http://{{ vip_proxy }}:30000
PROXY_ADMIN_TOKEN={{ proxy_admin_token }}
{% endif %}
DEPLOY_ENABLED={{ 'true' if chainlens_deploy_enabled | bool else 'false' }}
SECTIONS_ENABLED={{ 'true' if chainlens_sections_enabled | bool else 'false' }}
TRANSFER_UNDO_DAYS={{ transfer_undo_days }}
# the commit the hosts have; links in the navigation
APP_COMMIT={{ repo_commit }}
GRAFANA_URL=http://{{ ip_of[groups['monitoring_hosts'][0]] }}:3000
DOCS_URL={{ ('http://' ~ ip_of[groups['monitoring_hosts'][0]] ~ ':30300') if docs_site_enabled | bool else '' }}
# Network page: each Besu node's metrics endpoint (name=host:port:role)
NETWORK_NODES={% for n in besu_nodes %}{{ n.name }}={{ ip_of[n.host] }}:{{ n.metrics_port }}:{{ n.role }} {% endfor %}

# Section gateways (14-gateway.yml): the Sections page shows a notice while one is offline
GATEWAYS={% for h in gateway_hosts_list %}{{ hostvars[h].gateway_section }}=http://{{ ip_of[h] }}:{{ gateway_port }} {% endfor %}

GATEWAY_REPORT_TOKEN={{ gateway_report_token if gateway_hosts_list else '' }}

