# Managed by Ansible (ansible/09-monitoring.yml). Chainlens reads rpc2.
BESU_RPC=http://{{ ip_of[chainlens_rpc_host] }}:{{ (besu_nodes | selectattr('host', 'equalto', chainlens_rpc_host) | selectattr('role', 'equalto', 'rpc') | first).rpc_port }}
PORT=30100
SENDER01={{ sender01 }}
# Records written by the Deploy page (copied back to the repository by 09-monitoring.yml)
CONTRACT_LOCAL_DIR={{ chainlens_local_registry }}
{% if chainlens_deploy_enabled | bool or chainlens_sections_enabled | bool %}
# Admin pages (Deploy, Sections): only from operator_ip and chainlens_deploy_ips, with the token
ADMIN_TOKEN={{ chainlens_deploy_token }}
ADMIN_ALLOWED_IPS={{ ([operator_ip] + chainlens_deploy_ips) | join(' ') }}
{% endif %}
{% if chainlens_deploy_enabled | bool %}
# Deploy page (chainlens_deploy_enabled)
DEPLOY_ENABLED=true
DEPLOYER={{ chainlens_deployer }}
COORDINATOR_URL=http://{{ vip_rpc }}:9100
MAX_GAS={{ mpc_max_gas }}
{% else %}
DEPLOY_ENABLED=false
{% endif %}
{% if chainlens_sections_enabled | bool %}
# Sections page (chainlens_sections_enabled): forwards to the proxy's admin API
SECTIONS_ENABLED=true
PROXY_ADMIN_URL=http://{{ vip_proxy }}:30000
PROXY_ADMIN_TOKEN={{ proxy_admin_token }}
{% else %}
SECTIONS_ENABLED=false
{% endif %}
