# Copy to .env (chmod 600) on each Besu host.
BESU_IMAGE=hyperledger/besu:26.11.0
# validator | rpc
BESU_ROLE=validator
# short unique name, used in the files sent to the operator (e.g. validator1, rpc1, rpc-explorer)
NODE_NAME=validator1
# this host's private / WireGuard IP: advertised to peers and used for p2p + metrics
P2P_HOST=10.10.1.11
BIND_IP=10.10.1.11
P2P_PORT=30303
METRICS_PORT=9545
# JSON-RPC publish address: validators 127.0.0.1 (operator only); RPC nodes the private IP
RPC_BIND_IP=127.0.0.1
RPC_PORT=8545
WS_PORT=8546
JAVA_OPTS=-Xmx4g
# --- Validators: block gas limit target (optional) ---
# Only needed to CHANGE the limit of a running chain (the genesis can't be edited): Besu moves the
# block gas limit toward this value by a small step per block. Set the same value on every validator.
#BESU_TARGET_GAS_LIMIT=30000000
# --- RPC nodes only (leave commented on validators) ---
# Host names/IPs clients put in the URL (Besu rejects other Host headers)
#BESU_HOST_ALLOWLIST=10.10.1.21,rpc1.internal,localhost,127.0.0.1
# APIs: apps (proxy, MPC coordinator) -> ETH,NET,WEB3,TXPOOL ; explorer-only node -> ETH,NET,WEB3
#BESU_RPC_HTTP_API=ETH,NET,WEB3,TXPOOL
#BESU_RPC_WS_API=ETH,NET,WEB3,TXPOOL
